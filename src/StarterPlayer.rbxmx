      <Item class="LocalScript" referent="2">
        <Properties>
          <string name="Name">NecroMVP_WeaponClient</string>
          <BinaryString name="AttributesSerialize">AQAAAAgAAABOZWNyb01WUAMB</BinaryString>
          <bool name="DefinesCapabilities">false</bool>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <token name="RunContext">0</token>
          <BinaryString name="ScriptGuid"><![CDATA[ezNFNjA3QUI4LUNDRTMtNDM3Ni05RkQxLTQ3NTE4RDZFOEFEN30=]]></BinaryString>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local remote = ReplicatedStorage:WaitForChild("NecroMVP_Swing")
local player = Players.LocalPlayer

local function connect_tool(tool)
	if tool.Name ~= "Bone Sword" then
		return
	end

	tool.Activated:Connect(function()
		remote:FireServer()
	end)
end

local function on_character_added()
	local backpack = player:WaitForChild("Backpack")
	backpack.ChildAdded:Connect(connect_tool)
	for _, t in ipairs(backpack:GetChildren()) do
		connect_tool(t)
	end
end

if player.Character then
	on_character_added()
end

player.CharacterAdded:Connect(on_character_added)
]]></string>
          <int64 name="SourceAssetId">-1</int64>
          <BinaryString name="Tags"></BinaryString>
        </Properties>
      </Item>
