            <string name="Source"><![CDATA[local VisualService = {}

local GameConfig = require(script.Parent.GameConfig)

local function clamp01(x)
	if x < 0 then
		return 0
	end
	if x > 1 then
		return 1
	end
	return x
end

local function build_healthbar_gui(adornee_part)
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Adornee = adornee_part
	gui.AlwaysOnTop = true
	gui.MaxDistance = GameConfig.HealthBar.MaxDistance
	gui.StudsOffset = GameConfig.HealthBar.StudsOffset
	gui.Size = GameConfig.HealthBar.Size

	local name_label = Instance.new("TextLabel")
	name_label.Name = "Name"
	name_label.BackgroundTransparency = 1
	name_label.Size = UDim2.new(1, 0, 0, 10)
	name_label.Position = UDim2.new(0, 0, 0, 0)
	name_label.TextScaled = true
	name_label.Font = Enum.Font.GothamBold
	name_label.TextColor3 = Color3.fromRGB(235, 235, 235)
	name_label.TextStrokeTransparency = 0.4
	name_label.Parent = gui

	local bg = Instance.new("Frame")
	bg.Name = "BG"
	bg.Size = UDim2.new(1, 0, 0, 8)
	bg.Position = UDim2.new(0, 0, 0, 10)
	bg.BorderSizePixel = 0
	bg.BackgroundTransparency = 0.25
	bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	bg.Parent = gui

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BorderSizePixel = 0
	fill.Parent = bg

	return gui
end

local function update_fill(bar_gui, hp, max_hp)
	local bg = bar_gui:FindFirstChild("BG")
	if not bg then
		return
	end

	local fill = bg:FindFirstChild("Fill")
	if not fill then
		return
	end

	local denom = max_hp
	if typeof(denom) ~= "number" or denom <= 0 then
		denom = 1
	end

	local ratio = clamp01(hp / denom)
	fill.Size = UDim2.new(ratio, 0, 1, 0)

	if ratio > 0.6 then
		fill.BackgroundColor3 = Color3.fromRGB(60, 200, 80)
	elseif ratio > 0.3 then
		fill.BackgroundColor3 = Color3.fromRGB(240, 200, 60)
	else
		fill.BackgroundColor3 = Color3.fromRGB(230, 70, 70)
	end
end

local function update_name(bar_gui, part)
	local label = bar_gui:FindFirstChild("Name")
	if not label then
		return
	end

	local display_name = part:GetAttribute("DisplayName") or part.Name or "Unit"
	label.Text = tostring(display_name)

	local is_named = part:GetAttribute("IsNamedNPC") == true
	if is_named then
		label.TextColor3 = Color3.fromRGB(230, 60, 60) -- red name
	else
		label.TextColor3 = Color3.fromRGB(235, 235, 235)
	end
end

function VisualService.AttachHealthBar(part)
	if not GameConfig.HealthBar.Enabled then
		return
	end
	if not part or not part:IsA("BasePart") then
		return
	end
	if part:FindFirstChild("HealthBar") then
		return
	end

	local max_hp = part:GetAttribute("MaxHP") or part:GetAttribute("HP") or 1
	local hp = part:GetAttribute("HP") or max_hp

	local gui = build_healthbar_gui(part)
	gui.Parent = part

	update_name(gui, part)
	update_fill(gui, hp, max_hp)

	part:GetAttributeChangedSignal("HP"):Connect(function()
		if not part.Parent then
			return
		end
		update_fill(gui, part:GetAttribute("HP") or 0, part:GetAttribute("MaxHP") or max_hp)
	end)

	part:GetAttributeChangedSignal("MaxHP"):Connect(function()
		if not part.Parent then
			return
		end
		update_fill(gui, part:GetAttribute("HP") or 0, part:GetAttribute("MaxHP") or max_hp)
	end)

	part:GetAttributeChangedSignal("DisplayName"):Connect(function()
		if not part.Parent then
			return
		end
		update_name(gui, part)
	end)

	part:GetAttributeChangedSignal("IsNamedNPC"):Connect(function()
		if not part.Parent then
			return
		end
		update_name(gui, part)
	end)
end

return VisualService
]]></string>
