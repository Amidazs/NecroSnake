          </Content>
          <token name="RunContext">0</token>
          <BinaryString name="ScriptGuid"><![CDATA[ezREN0FCQkQxLTVBMDEtNEEzMy05OERCLUM1RkY5OEZGMDlGN30=]]></BinaryString>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local server_root = ServerScriptService:WaitForChild("NecromancerMVP_Server")
local systems = server_root:WaitForChild("Systems")

local GameConfig = require(systems.GameConfig)
local ModelLibraryService = require(systems.ModelLibraryService)
local ArmyService = require(systems.ArmyService)
local CombatService = require(systems.CombatService)
local NPCService = require(systems.NPCService)
local RegenService = require(systems.RegenService)
local WeaponService = require(systems.WeaponService)

local world_root = Workspace:WaitForChild("NecromancerMVP_World")
local world_units = world_root:WaitForChild("Units")
local world_leaders = world_root:WaitForChild("Leaders")

local function sync_player_hp_to_humanoid(character, hp)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.MaxHealth = hp
	humanoid.Health = hp
end

local function setup_player(player)
	player.CharacterAdded:Connect(function(character)
		local hrp = character:WaitForChild("HumanoidRootPart")

		local hp = GameConfig.PlayerBaseHealth
		local dmg = GameConfig.PlayerBaseDamage

		hrp:SetAttribute("OwnerId", player.UserId)
		hrp:SetAttribute("HP", hp)
		hrp:SetAttribute("MaxHP", hp)
		hrp:SetAttribute("Damage", dmg)
		hrp:SetAttribute("LeaderKind", "Player")
		hrp:SetAttribute("DisplayName", player.Name)

		sync_player_hp_to_humanoid(character, hp)
		ArmyService.BindPlayerCharacterCollision(character)

		-- Respawn always resets to start army
		ArmyService.CreateArmy(player.UserId, hrp, "Player", nil)
		WeaponService.GiveTool(player)

		print("Player ready:", player.Name)
	end)
end

-- Sanitize ModelLibrary at boot (keeps anim containers; disables collisions)
ModelLibraryService.SanitizeLibrary()

ArmyService.Start(world_units, world_leaders)
CombatService.Start()
NPCService.Start(world_leaders)
RegenService.Start()
WeaponService.Start()

Players.PlayerAdded:Connect(setup_player)
for _, p in ipairs(Players:GetPlayers()) do
	setup_player(p)
end
]]></string>
