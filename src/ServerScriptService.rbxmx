            <BinaryString name="ScriptGuid"><![CDATA[e0FFRUM4MURFLUM2RjktNEEyOS04NjJCLUYwNDc4NzRGNEE2Qn0=]]></BinaryString>
            <string name="Source"><![CDATA[local ModelLibraryService = {}

local Workspace = game:GetService("Workspace")

local function get_library()
	local world_root = Workspace:FindFirstChild("NecromancerMVP_World")
	if not world_root then
		return nil
	end
	return world_root:FindFirstChild("ModelLibrary")
end

local function disable_collisions(root)
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("BasePart") then
			inst.CanCollide = false
			inst.CanTouch = false
			inst.CanQuery = false
			inst.Anchored = false
			inst.Massless = true
		end
	end
end

local function ensure_primary_part(model)
	if model.PrimaryPart then
		return
	end
	local part = model:FindFirstChildWhichIsA("BasePart", true)
	if part then
		model.PrimaryPart = part
	end
end

local function is_under_animation_container(inst)
	local parent = inst.Parent
	while parent do
		if parent:IsA("AnimationController") or parent:IsA("Animator") then
			return true
		end
		parent = parent.Parent
	end
	return false
end

local function remove_conflicting_scripts(root)
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript") then
			-- Keep anything directly under animation containers.
			if not is_under_animation_container(inst) then
				inst:Destroy()
			end
		end
	end
end

function ModelLibraryService.SanitizeLibrary()
	local library = get_library()
	if not library then
		warn("ModelLibraryService: Missing ModelLibrary.")
		return
	end

	local cleaned = 0
	for _, child in ipairs(library:GetChildren()) do
		if child:IsA("Model") then
			disable_collisions(child)
			ensure_primary_part(child)
			remove_conflicting_scripts(child)
			cleaned += 1
		end
	end

	print(string.format(
		"ModelLibrary sanitized (%d models). Anim containers kept; collisions disabled.",
		cleaned
	))
end

function ModelLibraryService.GetTemplate(model_key)
	local library = get_library()
	if not library then
		return nil
	end

	local model = library:FindFirstChild(model_key)
	if model and model:IsA("Model") then
		return model
	end

	return nil
end

return ModelLibraryService
]]></string>
