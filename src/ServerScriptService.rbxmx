            <BinaryString name="ScriptGuid"><![CDATA[ezBCMTAzMUE0LTY5RkItNDVFNi1CNzE1LTlBRDQxQjNDMzQ1QX0=]]></BinaryString>
            <string name="Source"><![CDATA[local ArmyService = {}

local PhysicsService = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")

local GameConfig = require(script.Parent.GameConfig)
local VisualService = require(script.Parent.VisualService)
local UnitModelService = require(script.Parent.UnitModelService)

local COLLISION_NPC_UNITS = "NecroUnits"
local COLLISION_NPC_LEADERS = "NecroLeaders"
local COLLISION_PLAYER = "NecroPlayer"
local COLLISION_PLAYER_UNITS = "NecroPlayerUnits"

local active_armies = {}
local roam_units = {}
local roam_leaders = {}

local function register_collision_groups()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(COLLISION_NPC_UNITS)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup(COLLISION_NPC_LEADERS)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup(COLLISION_PLAYER)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup(COLLISION_PLAYER_UNITS)
	end)

	PhysicsService:CollisionGroupSetCollidable(COLLISION_NPC_UNITS, COLLISION_NPC_UNITS, false)
	PhysicsService:CollisionGroupSetCollidable(COLLISION_PLAYER_UNITS, COLLISION_PLAYER_UNITS, false)
	PhysicsService:CollisionGroupSetCollidable(COLLISION_PLAYER_UNITS, COLLISION_NPC_UNITS, true)
	PhysicsService:CollisionGroupSetCollidable(COLLISION_PLAYER_UNITS, COLLISION_NPC_LEADERS, true)
	PhysicsService:CollisionGroupSetCollidable(COLLISION_PLAYER_UNITS, COLLISION_PLAYER, false)
	PhysicsService:CollisionGroupSetCollidable(COLLISION_NPC_UNITS, COLLISION_PLAYER, true)
	PhysicsService:CollisionGroupSetCollidable(COLLISION_NPC_LEADERS, COLLISION_PLAYER, true)
	PhysicsService:CollisionGroupSetCollidable(COLLISION_NPC_UNITS, COLLISION_NPC_LEADERS, false)
end

local function assign_collision(part, group_name)
	if part and part:IsA("BasePart") then
		part.CollisionGroup = group_name
	end
end

local function build_mover(part)
	local attach0 = Instance.new("Attachment")
	attach0.Parent = part

	local align_pos = Instance.new("AlignPosition")
	align_pos.Mode = Enum.PositionAlignmentMode.OneAttachment
	align_pos.Attachment0 = attach0
	align_pos.MaxForce = GameConfig.Roam.MaxForce
	align_pos.Responsiveness = GameConfig.Roam.Responsiveness
	align_pos.MaxVelocity = GameConfig.Roam.MaxVelocity
	align_pos.Parent = part

	local align_rot = Instance.new("AlignOrientation")
	align_rot.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align_rot.Attachment0 = attach0
	align_rot.MaxTorque = GameConfig.Roam.MaxTorque
	align_rot.Responsiveness = GameConfig.Roam.Responsiveness
	align_rot.Parent = part

	return align_pos
end

local function apply_collision_to_character(character)
	for _, inst in ipairs(character:GetDescendants()) do
		if inst:IsA("BasePart") then
			assign_collision(inst, COLLISION_PLAYER)
		end
	end
end

function ArmyService.Start(world_units_folder, world_leaders_folder)
	ArmyService._units_folder = world_units_folder
	ArmyService._leaders_folder = world_leaders_folder

	register_collision_groups()

	print("ArmyService: Ready.")

	RunService.Heartbeat:Connect(function()
		for _, army in pairs(active_armies) do
			if army.Leader and army.Leader.Parent then
				ArmyService.UpdateFormation(army)
			end
		end
	end)
end

function ArmyService.BindPlayerCharacterCollision(character)
	if not character then
		return
	end

	apply_collision_to_character(character)

	character.DescendantAdded:Connect(function(inst)
		if inst:IsA("BasePart") then
			assign_collision(inst, COLLISION_PLAYER)
		end
	end)
end

function ArmyService.ClearArmyUnits(owner_id)
	local army = active_armies[owner_id]
	if not army then
		return
	end

	for _, data in ipairs(army.Units) do
		if data.Instance and data.Instance.Parent then
			data.Instance:Destroy()
		end
	end

	army.Units = {}
	army.NextFormationIndex = 1
end

function ArmyService.CreateArmy(owner_id, leader_part, leader_kind, start_army_definition)
	if active_armies[owner_id] then
		ArmyService.ClearArmyUnits(owner_id)
		active_armies[owner_id].Leader = leader_part
		active_armies[owner_id].LeaderKind = leader_kind
	else
		active_armies[owner_id] = {
			OwnerId = owner_id,
			Leader = leader_part,
			LeaderKind = leader_kind,
			Units = {},
			NextFormationIndex = 1,
		}
	end

	leader_part:SetAttribute("OwnerId", owner_id)
	leader_part:SetAttribute("Kind", "Leader")
	leader_part:SetAttribute("LeaderKind", leader_kind)

	if leader_kind == "Player" then
		assign_collision(leader_part, COLLISION_PLAYER)
	else
		assign_collision(leader_part, COLLISION_NPC_LEADERS)
	end

	VisualService.AttachHealthBar(leader_part)

	local model_key = leader_part:GetAttribute("ModelKey")
	if typeof(model_key) == "string" and model_key ~= "" then
		UnitModelService.ApplyModel(leader_part, model_key)
	end

	if leader_kind == "Player" then
		for _ = 1, GameConfig.PlayerArmy.StartCount do
			ArmyService.AddUnitToArmy(owner_id, GameConfig.PlayerArmy.StartType)
		end
		return
	end

	if typeof(start_army_definition) == "table" then
		for _, entry in ipairs(start_army_definition) do
			if typeof(entry) == "table" then
				local unit_type = entry.Type
				local count = entry.Count
				if typeof(unit_type) == "string" and typeof(count) == "number" then
					for _ = 1, count do
						ArmyService.AddUnitToArmy(owner_id, unit_type)
					end
				end
			end
		end
	end
end

function ArmyService.HasArmy(owner_id)
	return active_armies[owner_id] ~= nil
end

function ArmyService.GetArmy(owner_id)
	return active_armies[owner_id]
end

function ArmyService.AddUnitToArmy(owner_id, unit_type)
	local army = active_armies[owner_id]
	if not army or not army.Leader or not army.Leader.Parent then
		return
	end

	local stats = GameConfig.Units[unit_type] or GameConfig.Units.Skeleton

	local unit = Instance.new("Part")
	unit.Name = unit_type
	unit.Size = Vector3.new(stats.Size, stats.Size, stats.Size)
	unit.Color = stats.Color
	unit.Material = Enum.Material.Plastic
	unit.CanCollide = true
	unit.Anchored = false
	unit.Position = army.Leader.Position + Vector3.new(0, 8, 0)
	unit.Parent = ArmyService._units_folder

	unit:SetAttribute("OwnerId", owner_id)
	unit:SetAttribute("Kind", "Unit")
	unit:SetAttribute("Type", unit_type)
	unit:SetAttribute("HP", stats.Health)
	unit:SetAttribute("MaxHP", stats.Health)
	unit:SetAttribute("Damage", stats.Damage)
	unit:SetAttribute("DisplayName", unit_type)

	local formation_index = army.NextFormationIndex or 1
	army.NextFormationIndex = formation_index + 1
	unit:SetAttribute("FormationIndex", formation_index)

	local is_player_army = (typeof(owner_id) == "number")
	if is_player_army then
		assign_collision(unit, COLLISION_PLAYER_UNITS)
	else
		assign_collision(unit, COLLISION_NPC_UNITS)
	end

	VisualService.AttachHealthBar(unit)
	UnitModelService.ApplyModel(unit, unit_type)

	local attach0 = Instance.new("Attachment")
	attach0.Parent = unit

	local align_pos = Instance.new("AlignPosition")
	align_pos.Mode = Enum.PositionAlignmentMode.OneAttachment
	align_pos.Attachment0 = attach0
	align_pos.MaxForce = 35000 * stats.Mass
	align_pos.Responsiveness = 10
	align_pos.MaxVelocity = 28
	align_pos.Parent = unit

	local align_rot = Instance.new("AlignOrientation")
	align_rot.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align_rot.Attachment0 = attach0
	align_rot.MaxTorque = 35000 * stats.Mass
	align_rot.Responsiveness = 10
	align_rot.Parent = unit

	table.insert(army.Units, { Instance = unit, AlignPos = align_pos })
end

local function compute_formation_pos(leader_pos, formation_index)
	local golden = GameConfig.Formation.GoldenAngle
	local inner_cap = GameConfig.Formation.InnerCapacity

	local i = formation_index
	if typeof(i) ~= "number" or i < 1 then
		i = 1
	end

	local is_inner = (i <= inner_cap)
	local local_i = i
	local spacing = GameConfig.Formation.OuterSpacing
	local radius_boost = 0

	if is_inner then
		spacing = GameConfig.Formation.InnerSpacing
	else
		local_i = i - inner_cap
		spacing = GameConfig.Formation.OuterSpacing
		radius_boost = GameConfig.Formation.OuterRadiusBoost
	end

	local r = (spacing * math.sqrt(local_i)) + radius_boost
	local theta = local_i * golden

	return Vector3.new(
		leader_pos.X + r * math.cos(theta),
		leader_pos.Y,
		leader_pos.Z + r * math.sin(theta)
	)
end

function ArmyService.UpdateFormation(army)
	local leader = army.Leader
	if not leader or not leader.Parent then
		return
	end

	local center = leader.Position
	for _, unit_data in ipairs(army.Units) do
		local unit = unit_data.Instance
		if unit and unit.Parent then
			local idx = unit:GetAttribute("FormationIndex") or 1
			unit_data.AlignPos.Position = compute_formation_pos(center, idx)
		end
	end
end

function ArmyService.RemoveRareArmy(owner_id)
	local army = active_armies[owner_id]
	if not army then
		return
	end

	if army.Leader and army.Leader.Parent then
		army.Leader:Destroy()
	end

	ArmyService.ClearArmyUnits(owner_id)
	active_armies[owner_id] = nil
end

function ArmyService.RemoveRoamUnit(unit_part)
	if not unit_part then
		return
	end

	for idx = #roam_units, 1, -1 do
		if roam_units[idx].Part == unit_part then
			table.remove(roam_units, idx)
			break
		end
	end

	unit_part:Destroy()
end

function ArmyService.CreateRoamingUnit(owner_id, unit_type, position, group_id, offset_vec)
	local stats = GameConfig.Units[unit_type] or GameConfig.Units.Skeleton

	local unit = Instance.new("Part")
	unit.Name = unit_type
	unit.Size = Vector3.new(stats.Size, stats.Size, stats.Size)
	unit.Color = stats.Color
	unit.Material = Enum.Material.Plastic
	unit.CanCollide = true
	unit.Anchored = false
	unit.Position = position
	unit.Parent = ArmyService._units_folder

	unit:SetAttribute("OwnerId", owner_id)
	unit:SetAttribute("Kind", "Unit")
	unit:SetAttribute("Type", unit_type)
	unit:SetAttribute("HP", stats.Health)
	unit:SetAttribute("MaxHP", stats.Health)
	unit:SetAttribute("Damage", stats.Damage)
	unit:SetAttribute("GroupId", group_id)
	unit:SetAttribute("DisplayName", unit_type)

	assign_collision(unit, COLLISION_NPC_UNITS)

	VisualService.AttachHealthBar(unit)
	UnitModelService.ApplyModel(unit, unit_type)

	local align_pos = build_mover(unit)

	table.insert(roam_units, {
		OwnerId = owner_id,
		GroupId = group_id,
		Offset = offset_vec or Vector3.new(0, 0, 0),
		Part = unit,
		AlignPos = align_pos,
	})

	return unit
end

function ArmyService.CreateRoamingLeader(owner_id, leader_part)
	local align_pos = build_mover(leader_part)
	table.insert(roam_leaders, { OwnerId = owner_id, Part = leader_part, AlignPos = align_pos })
	return align_pos
end

function ArmyService.PruneRoamLists()
	for i = #roam_units, 1, -1 do
		local p = roam_units[i].Part
		if not p or not p.Parent then
			table.remove(roam_units, i)
		end
	end

	for i = #roam_leaders, 1, -1 do
		local p = roam_leaders[i].Part
		if not p or not p.Parent then
			table.remove(roam_leaders, i)
		end
	end
end

function ArmyService.GetRoamUnits()
	return roam_units
end

function ArmyService.GetRoamLeaders()
	return roam_leaders
end

function ArmyService.IsLeader(part)
	return part and part:GetAttribute("Kind") == "Leader"
end

function ArmyService.GetAllCombatParts()
	local list = {}

	for _, army in pairs(active_armies) do
		if army.Leader and army.Leader.Parent then
			table.insert(list, army.Leader)
		end
		for _, unit_data in ipairs(army.Units) do
			local unit = unit_data.Instance
			if unit and unit.Parent then
				table.insert(list, unit)
			end
		end
	end

	for _, data in ipairs(roam_units) do
		local unit = data.Part
		if unit and unit.Parent then
			table.insert(list, unit)
		end
	end

	return list
end

return ArmyService
]]></string>
