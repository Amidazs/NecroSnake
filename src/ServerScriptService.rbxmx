            <string name="Source"><![CDATA[local AttackFxService = {}

local Debris = game:GetService("Debris")

function AttackFxService.Play(attacker_part)
	if not attacker_part or not attacker_part:IsA("BasePart") then
		return
	end

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "AttackSlash"
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.12, 0.18)
	emitter.Speed = NumberRange.new(10, 14)
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-120, 120)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = attacker_part
	emitter:Emit(10)

	Debris:AddItem(emitter, 0.25)
end

return AttackFxService
]]></string>
