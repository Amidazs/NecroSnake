            <string name="Source"><![CDATA[local CombatService = {}

local Players = game:GetService("Players")

local GameConfig = require(script.Parent.GameConfig)
local ArmyService = require(script.Parent.ArmyService)
local AttackFxService = require(script.Parent.AttackFxService)

local ATTACK_RANGE = GameConfig.Combat.AttackRange
local ATTACK_COOLDOWN = GameConfig.Combat.AttackCooldown
local COMBAT_LOCK_SECONDS = GameConfig.Combat.CombatLockSeconds

local owner_last_combat_time = {}

local function now()
	return os.clock()
end

local function is_alive(part)
	local hp = part:GetAttribute("HP")
	return typeof(hp) == "number" and hp > 0
end

local function apply_hit_flash(target)
	local old_color = target.Color
	target.Color = Color3.new(1, 1, 1)
	task.delay(0.08, function()
		if target.Parent then
			target.Color = old_color
		end
	end)
end

local function mark_in_combat(owner_a, owner_b)
	local t = now()
	if owner_a ~= nil then
		owner_last_combat_time[owner_a] = t
	end
	if owner_b ~= nil then
		owner_last_combat_time[owner_b] = t
	end
end

function CombatService.IsOwnerInCombat(owner_id)
	local t = owner_last_combat_time[owner_id]
	if not t then
		return false
	end
	return (now() - t) <= COMBAT_LOCK_SECONDS
end

local function get_player_from_leader(target_leader)
	local owner_id = target_leader:GetAttribute("OwnerId")
	if typeof(owner_id) ~= "number" then
		return nil
	end
	return Players:GetPlayerByUserId(owner_id)
end

local function should_raise()
	return math.random() < GameConfig.RaiseChanceBase
end

local function try_raise_unit(killer_owner, unit_type, guaranteed)
	if killer_owner == nil then
		return
	end
	if not ArmyService.HasArmy(killer_owner) then
		return
	end

	if guaranteed then
		ArmyService.AddUnitToArmy(killer_owner, unit_type)
		return
	end

	if should_raise() then
		ArmyService.AddUnitToArmy(killer_owner, unit_type)
	end
end

local function resolve_player_death(victim_leader)
	local player = get_player_from_leader(victim_leader)
	if player and player.Character then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = 0
		else
			player.Character:BreakJoints()
		end
	end
end

local function grant_loot_from_rare_leader(killer_owner, rare_leader_part)
	if typeof(killer_owner) ~= "number" then
		return
	end

	local boss_raise = rare_leader_part:GetAttribute("BossRaiseType")
	if typeof(boss_raise) == "string" and boss_raise ~= "" then
		-- 100% guaranteed leader raise reward
		try_raise_unit(killer_owner, boss_raise, true)
	end

	local attrs = rare_leader_part:GetAttributes()
	for key, value in pairs(attrs) do
		if typeof(key) == "string" and string.sub(key, 1, 5) == "Loot_" then
			local unit_type = string.sub(key, 6)
			if typeof(value) == "number" and value > 0 then
				for _ = 1, value do
					try_raise_unit(killer_owner, unit_type, false)
				end
			end
		end
	end
end

local function resolve_rare_leader_death(killer_part, victim_leader)
	local killer_owner = killer_part and killer_part:GetAttribute("OwnerId") or nil
	local rare_owner = victim_leader:GetAttribute("OwnerId")

	grant_loot_from_rare_leader(killer_owner, victim_leader)
	ArmyService.RemoveRareArmy(rare_owner)
end

local function resolve_unit_death(killer_part, victim_unit)
	local victim_type = victim_unit:GetAttribute("Type") or "Skeleton"
	local killer_owner = killer_part and killer_part:GetAttribute("OwnerId") or nil

	if victim_unit:GetAttribute("GroupId") then
		ArmyService.RemoveRoamUnit(victim_unit)
	else
		victim_unit:Destroy()
	end

	try_raise_unit(killer_owner, victim_type, false)
end

local function resolve_death(killer_part, victim_part)
	if ArmyService.IsLeader(victim_part) then
		local leader_kind = victim_part:GetAttribute("LeaderKind")
		if leader_kind == "Player" then
			resolve_player_death(victim_part)
		else
			resolve_rare_leader_death(killer_part, victim_part)
		end
		return
	end

	resolve_unit_death(killer_part, victim_part)
end

local function apply_damage_to_player(target_leader, dmg)
	local player = get_player_from_leader(target_leader)
	if not player then
		return
	end

	local char = player.Character
	if not char then
		return
	end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if humanoid.Health <= 0 then
		return
	end

	humanoid:TakeDamage(dmg)

	target_leader:SetAttribute("MaxHP", humanoid.MaxHealth)
	target_leader:SetAttribute("HP", humanoid.Health)
end

function CombatService.Start()
	print("CombatService: Starting combat loop...")
	task.spawn(function()
		while true do
			CombatService.GameLoop()
			task.wait(ATTACK_COOLDOWN)
		end
	end)
end

function CombatService.GameLoop()
	local parts = ArmyService.GetAllCombatParts()
	local count = #parts
	if count <= 1 then
		return
	end

	for i = 1, count do
		local attacker = parts[i]
		if attacker and attacker.Parent and is_alive(attacker) then
			local owner_a = attacker:GetAttribute("OwnerId")
			local best_target = nil
			local min_dst = ATTACK_RANGE

			for j = 1, count do
				if j ~= i then
					local victim = parts[j]
					if victim and victim.Parent and is_alive(victim) then
						local owner_b = victim:GetAttribute("OwnerId")
						if owner_b and owner_b ~= owner_a then
							local dst = (attacker.Position - victim.Position).Magnitude
							if dst < min_dst then
								min_dst = dst
								best_target = victim
							end
						end
					end
				end
			end

			if best_target then
				CombatService.Attack(attacker, best_target)
			end
		end
	end
end

function CombatService.Attack(attacker, target)
	local dmg = attacker:GetAttribute("Damage")
	if typeof(dmg) ~= "number" then
		dmg = 5
	end

	local owner_a = attacker:GetAttribute("OwnerId")
	local owner_b = target:GetAttribute("OwnerId")
	mark_in_combat(owner_a, owner_b)

	AttackFxService.Play(attacker)

	if ArmyService.IsLeader(target) and target:GetAttribute("LeaderKind") == "Player" then
		apply_damage_to_player(target, dmg)
		apply_hit_flash(target)

		local hp = target:GetAttribute("HP")
		if typeof(hp) == "number" and hp <= 0 then
			resolve_death(attacker, target)
		end
		return
	end

	local current_hp = target:GetAttribute("HP")
	local max_hp = target:GetAttribute("MaxHP")
	if typeof(current_hp) ~= "number" or typeof(max_hp) ~= "number" then
		return
	end

	local new_hp = current_hp - dmg
	target:SetAttribute("HP", new_hp)

	apply_hit_flash(target)

	if new_hp <= 0 then
		resolve_death(attacker, target)
	end
end

return CombatService
]]></string>
