            <BinaryString name="ScriptGuid"><![CDATA[ezJFMjFGM0UyLUM1OEItNDNCNC05MTY1LUQ5NjZBMUM1M0ZFQn0=]]></BinaryString>
            <string name="Source"><![CDATA[local NPCService = {}

local Players = game:GetService("Players")

local GameConfig = require(script.Parent.GameConfig)
local ArmyService = require(script.Parent.ArmyService)
local CombatService = require(script.Parent.CombatService)

local function rand_range(a, b)
	return a + (b - a) * math.random()
end

local function clamp_to_arena(pos)
	local c = GameConfig.Arena.Center
	local h = GameConfig.Arena.HalfSize
	local x = math.clamp(pos.X, c.X - h.X, c.X + h.X)
	local z = math.clamp(pos.Z, c.Z - h.Z, c.Z + h.Z)
	return Vector3.new(x, GameConfig.Arena.GroundY, z)
end

local function random_arena_position()
	local c = GameConfig.Arena.Center
	local h = GameConfig.Arena.HalfSize
	local x = rand_range(c.X - h.X, c.X + h.X)
	local z = rand_range(c.Z - h.Z, c.Z + h.Z)
	return Vector3.new(x, GameConfig.Arena.GroundY, z)
end

local function jitter_position(pos, radius)
	local x = pos.X + rand_range(-radius, radius)
	local z = pos.Z + rand_range(-radius, radius)
	return Vector3.new(x, pos.Y, z)
end

local function unit_power(part)
	if not part or not part.Parent then
		return 0
	end
	local hp = part:GetAttribute("HP")
	local dmg = part:GetAttribute("Damage")
	if typeof(hp) ~= "number" then
		hp = 0
	end
	if typeof(dmg) ~= "number" then
		dmg = 0
	end
	return hp + (dmg * 12)
end

local function get_player_entities()
	local entities = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				table.insert(entities, {
					OwnerId = player.UserId,
					Position = hrp.Position,
					Power = unit_power(hrp),
				})
			end
		end
	end
	return entities
end

local function compute_group_center(group_id)
	local sum = Vector3.new(0, 0, 0)
	local count = 0

	for _, data in ipairs(ArmyService.GetRoamUnits()) do
		if data.GroupId == group_id then
			local p = data.Part
			if p and p.Parent then
				sum += p.Position
				count += 1
			end
		end
	end

	if count <= 0 then
		return nil
	end

	local center = sum / count
	return Vector3.new(center.X, GameConfig.Arena.GroundY, center.Z)
end

local function group_power(owner_id, group_id)
	local total = 0
	for _, data in ipairs(ArmyService.GetRoamUnits()) do
		if data.OwnerId == owner_id and data.GroupId == group_id then
			total += unit_power(data.Part)
		end
	end
	return total
end

local function get_group_entities(group_owner_map)
	local entities = {}
	for group_id, owner_id in pairs(group_owner_map) do
		local center = compute_group_center(group_id)
		if center then
			table.insert(entities, {
				OwnerId = owner_id,
				GroupId = group_id,
				Position = center,
				Power = group_power(owner_id, group_id),
				Type = "Group",
			})
		end
	end
	return entities
end

local function get_rare_entities()
	local entities = {}
	for _, data in ipairs(ArmyService.GetRoamLeaders()) do
		local leader = data.Part
		if leader and leader.Parent then
			table.insert(entities, {
				OwnerId = data.OwnerId,
				Position = leader.Position,
				Power = unit_power(leader),
				Type = "Rare",
			})
		end
	end
	return entities
end

local function find_nearest_enemy_entity(self_owner_id, self_pos, group_owner_map)
	local best = nil
	local best_dist = GameConfig.AI.SenseRange

	for _, e in ipairs(get_player_entities()) do
		if e.OwnerId ~= self_owner_id then
			local d = (e.Position - self_pos).Magnitude
			if d < best_dist then
				best_dist = d
				best = e
			end
		end
	end

	for _, e in ipairs(get_group_entities(group_owner_map)) do
		if e.OwnerId ~= self_owner_id then
			local d = (e.Position - self_pos).Magnitude
			if d < best_dist then
				best_dist = d
				best = e
			end
		end
	end

	for _, e in ipairs(get_rare_entities()) do
		if e.OwnerId ~= self_owner_id then
			local d = (e.Position - self_pos).Magnitude
			if d < best_dist then
				best_dist = d
				best = e
			end
		end
	end

	return best
end

local function pick_wander_target(current_pos)
	local j = GameConfig.AI.WanderJitterStuds
	local jitter = Vector3.new(rand_range(-j, j), 0, rand_range(-j, j))
	return clamp_to_arena(Vector3.new(current_pos.X, GameConfig.Arena.GroundY, current_pos.Z) + jitter)
end

local function compute_chase_or_flee(self_pos, self_power, enemy_entity)
	local to_enemy = enemy_entity.Position - self_pos
	local dist = to_enemy.Magnitude
	if dist <= 0.01 then
		return pick_wander_target(self_pos)
	end

	local stronger = self_power >= (enemy_entity.Power * GameConfig.AI.Hysteresis)
	if stronger then
		if dist > GameConfig.AI.ChaseStopRange then
			return clamp_to_arena(Vector3.new(enemy_entity.Position.X, self_pos.Y, enemy_entity.Position.Z))
		end
		return clamp_to_arena(self_pos)
	end

	local away_dir = (-to_enemy).Unit
	local flee_pos = self_pos + (away_dir * GameConfig.AI.FleeDistance)
	return clamp_to_arena(Vector3.new(flee_pos.X, self_pos.Y, flee_pos.Z))
end

local function new_common_owner_id(counter)
	return "NPC_GRP_OWNER_" .. tostring(counter)
end

local function choose_random_composition()
	local list = GameConfig.CommonNPC.GroupCompositions
	return list[math.random(1, #list)]
end

local function count_alive_roam_units()
	local alive = 0
	for _, data in ipairs(ArmyService.GetRoamUnits()) do
		local p = data.Part
		if p and p.Parent then
			alive += 1
		end
	end
	return alive
end

local function choose_random_rare_definition()
	local list = GameConfig.RareNPC.Named
	return list[math.random(1, #list)]
end

local function count_alive_rare_leaders()
	ArmyService.PruneRoamLists()
	local alive = 0
	for _, data in ipairs(ArmyService.GetRoamLeaders()) do
		local p = data.Part
		if p and p.Parent then
			alive += 1
		end
	end
	return alive
end

local function spawn_common_group(state)
	if count_alive_roam_units() >= GameConfig.CommonNPC.MaxAliveUnits then
		return
	end

	state.group_counter += 1
	state.owner_counter += 1

	local owner_id = new_common_owner_id(state.owner_counter)
	local group_id = "G" .. tostring(state.group_counter)

	local center_pos = random_arena_position()
	local composition = choose_random_composition()

	state.group_owner[group_id] = owner_id
	state.group_target[group_id] = center_pos
	state.group_next[group_id] = 0

	local offset_radius = 7
	for idx, unit_type in ipairs(composition) do
		local angle = (idx / #composition) * math.pi * 2
		local offset = Vector3.new(math.cos(angle) * offset_radius, 0, math.sin(angle) * offset_radius)
		local spawn_pos = jitter_position(center_pos, GameConfig.CommonNPC.GroupSpawnRadius)
		ArmyService.CreateRoamingUnit(owner_id, unit_type, spawn_pos, group_id, offset)
	end
end

local function set_leader_loot_attributes(leader, army_def, boss_raise_type)
	local totals = {}
	for _, entry in ipairs(army_def) do
		local unit_type = entry.Type
		local count = entry.Count
		if typeof(unit_type) == "string" and typeof(count) == "number" then
			totals[unit_type] = (totals[unit_type] or 0) + count
		end
	end

	for unit_type, count in pairs(totals) do
		leader:SetAttribute("Loot_" .. unit_type, count)
	end

	if typeof(boss_raise_type) == "string" and boss_raise_type ~= "" then
		leader:SetAttribute("BossRaiseType", boss_raise_type)
	end
end

local function spawn_rare_named_npc(state, world_leaders_folder)
	if count_alive_rare_leaders() >= GameConfig.RareNPC.MaxAlive then
		return
	end
	if math.random() > GameConfig.RareNPC.SpawnChance then
		return
	end

	local def = choose_random_rare_definition()
	local owner_id = "NPC_RARE_" .. tostring(math.floor(os.clock() * 1000))

	local leader = Instance.new("Part")
	leader.Name = def.Name
	leader.Size = Vector3.new(6, 6, 6)
	leader.Color = def.LeaderColor
	leader.Material = Enum.Material.Neon
	leader.CanCollide = true
	leader.Anchored = false
	leader.Position = random_arena_position()
	leader.Parent = world_leaders_folder

	leader:SetAttribute("HP", def.LeaderHP)
	leader:SetAttribute("MaxHP", def.LeaderHP)
	leader:SetAttribute("Damage", def.LeaderDamage)
	leader:SetAttribute("ModelKey", def.ModelKey)
	leader:SetAttribute("IsNamedNPC", true)
	leader:SetAttribute("DisplayName", def.Name)

	set_leader_loot_attributes(leader, def.Army, def.BossRaiseType)

	ArmyService.CreateArmy(owner_id, leader, "NPC_Rare", def.Army)
	ArmyService.CreateRoamingLeader(owner_id, leader)

	print("RARE NPC SPAWNED: " .. def.Name)
end

local function update_group_target(state, group_id, t)
	local owner_id = state.group_owner[group_id]
	if not owner_id then
		return
	end

	if CombatService.IsOwnerInCombat(owner_id) then
		return
	end

	local next_t = state.group_next[group_id]
	if next_t and t < next_t then
		return
	end

	state.group_next[group_id] = t + rand_range(
		GameConfig.Roam.TargetUpdateMinSeconds,
		GameConfig.Roam.TargetUpdateMaxSeconds
	)

	local center = compute_group_center(group_id) or state.group_target[group_id] or random_arena_position()
	local self_power = group_power(owner_id, group_id)
	local enemy = find_nearest_enemy_entity(owner_id, center, state.group_owner)

	if enemy then
		state.group_target[group_id] = compute_chase_or_flee(center, self_power, enemy)
		return
	end

	state.group_target[group_id] = pick_wander_target(center)
end

local function update_groups(state)
	local t = os.clock()

	for group_id, _ in pairs(state.group_owner) do
		local center = compute_group_center(group_id)
		if not center then
			state.group_owner[group_id] = nil
			state.group_target[group_id] = nil
			state.group_next[group_id] = nil
		else
			update_group_target(state, group_id, t)
		end
	end

	for _, data in ipairs(ArmyService.GetRoamUnits()) do
		local p = data.Part
		if p and p.Parent then
			if not CombatService.IsOwnerInCombat(data.OwnerId) then
				local center_target = state.group_target[data.GroupId]
				if center_target then
					local desired = center_target + data.Offset
					data.AlignPos.Position = clamp_to_arena(Vector3.new(desired.X, p.Position.Y, desired.Z))
				end
			end
		end
	end
end

local function update_rare_leaders(state)
	ArmyService.PruneRoamLists()
	for _, data in ipairs(ArmyService.GetRoamLeaders()) do
		local leader = data.Part
		if leader and leader.Parent then
			if CombatService.IsOwnerInCombat(data.OwnerId) then
				continue
			end

			local self_pos = leader.Position
			local self_power = unit_power(leader)
			local enemy = find_nearest_enemy_entity(data.OwnerId, self_pos, state.group_owner)

			if enemy then
				data.AlignPos.Position = compute_chase_or_flee(self_pos, self_power, enemy)
			else
				data.AlignPos.Position = pick_wander_target(self_pos)
			end
		end
	end
end

function NPCService.Start(world_leaders_folder)
	local state = {
		group_counter = 0,
		owner_counter = 0,
		group_owner = {},
		group_target = {},
		group_next = {},
	}

	print("NPCService: Starting spawn + AI loops...")

	task.spawn(function()
		while true do
			spawn_common_group(state)
			task.wait(GameConfig.CommonNPC.SpawnIntervalSeconds)
		end
	end)

	task.spawn(function()
		while true do
			spawn_rare_named_npc(state, world_leaders_folder)
			task.wait(GameConfig.RareNPC.SpawnCheckSeconds)
		end
	end)

	task.spawn(function()
		while true do
			update_groups(state)
			update_rare_leaders(state)
			task.wait(0.18)
		end
	end)
end

return NPCService
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">WeaponService</string>
            <BinaryString name="AttributesSerialize">AQAAAAgAAABOZWNyb01WUAMB</BinaryString>
            <bool name="DefinesCapabilities">false</bool>
            <Content name="LinkedSource">
              <null>
              </null>
            </Content>
            <BinaryString name="ScriptGuid"><![CDATA[ezQ4OTc0MEY2LTIyNzYtNDk5Ny05NjAyLUUwMkNGMUFDNjdCNn0=]]></BinaryString>
            <string name="Source"><![CDATA[local WeaponService = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(script.Parent.GameConfig)

local REMOTE_NAME = "NecroMVP_Swing"
local last_swing_time = {}

local function get_remote()
	local existing = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end

	local r = Instance.new("RemoteEvent")
	r.Name = REMOTE_NAME
	r.Parent = ReplicatedStorage
	return r
end

local function can_swing(player)
	local t = os.clock()
	local last = last_swing_time[player.UserId]
	if last and (t - last) < GameConfig.Weapon.SwingCooldown then
		return false
	end

	last_swing_time[player.UserId] = t
	return true
end

local function build_hitbox(hrp)
	local hitbox = Instance.new("Part")
	hitbox.Name = "WeaponHitbox"
	hitbox.Size = GameConfig.Weapon.HitboxSize
	hitbox.Transparency = 1
	hitbox.CanCollide = false
	hitbox.Anchored = true
	hitbox.Parent = workspace

	local forward = hrp.CFrame.LookVector
	local pos = hrp.Position + (forward * GameConfig.Weapon.HitboxForwardStuds)
	hitbox.CFrame = CFrame.new(pos, pos + forward)

	return hitbox
end

local function resolve_target_core(part)
	if part:GetAttribute("HP") ~= nil then
		return part
	end

	local parent = part.Parent
	if parent and parent:IsA("Model") then
		local maybe_core = parent.Parent
		if maybe_core and maybe_core:IsA("BasePart") and maybe_core:GetAttribute("HP") ~= nil then
			return maybe_core
		end
	end

	return nil
end

local function apply_damage_to_part(player, target_part)
	if not target_part or not target_part.Parent then
		return
	end

	local owner_a = player.UserId
	local owner_b = target_part:GetAttribute("OwnerId")
	if owner_b == nil or owner_b == owner_a then
		return
	end

	local hp = target_part:GetAttribute("HP")
	local max_hp = target_part:GetAttribute("MaxHP")
	if typeof(hp) ~= "number" or typeof(max_hp) ~= "number" then
		return
	end
	if hp <= 0 then
		return
	end

	local new_hp = hp - GameConfig.Weapon.Damage
	target_part:SetAttribute("HP", new_hp)
	target_part:SetAttribute("LastHitBy", owner_a)

	if new_hp <= 0 then
		local char = player.Character
		if not char then
			return
		end

		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end

		local CombatService = require(script.Parent.CombatService)
		CombatService.Attack(hrp, target_part)
	end
end

local function collect_damage_targets(hitbox)
	local seen = {}
	local results = {}

	for _, part in ipairs(workspace:GetPartsInPart(hitbox)) do
		if part and part.Parent then
			local core = resolve_target_core(part)
			if core and not seen[core] then
				seen[core] = true
				table.insert(results, core)
			end
		end
	end

	return results
end

function WeaponService.GiveTool(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	if backpack:FindFirstChild("Bone Sword") then
		return
	end

	local tool = Instance.new("Tool")
	tool.Name = "Bone Sword"
	tool.RequiresHandle = true
	tool.CanBeDropped = false

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 4, 1)
	handle.Color = Color3.fromRGB(235, 235, 235)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Parent = tool

	tool.Parent = backpack
end

function WeaponService.Start()
	local remote = get_remote()

	remote.OnServerEvent:Connect(function(player)
		if not player or not player.Parent then
			return
		end

		if not can_swing(player) then
			return
		end

		local char = player.Character
		if not char then
			return
		end

		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end

		local hitbox = build_hitbox(hrp)
		local targets = collect_damage_targets(hitbox)

		for _, target in ipairs(targets) do
			apply_damage_to_part(player, target)
		end

		task.delay(0.10, function()
			if hitbox and hitbox.Parent then
				hitbox:Destroy()
			end
		end)
	end)
end

return WeaponService
]]></string>
