            <string name="Source"><![CDATA[local UnitModelService = {}

local ModelLibraryService = require(script.Parent.ModelLibraryService)

local function clear_visuals(core_part)
	for _, child in ipairs(core_part:GetChildren()) do
		if child:IsA("Model") and child.Name == "Visual" then
			child:Destroy()
		end
	end
end

local function weld_model_to_core(model, core_part)
	if not model.PrimaryPart then
		local part = model:FindFirstChildWhichIsA("BasePart", true)
		if not part then
			return false
		end
		model.PrimaryPart = part
	end

	model:SetPrimaryPartCFrame(core_part.CFrame)

	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Anchored = false
			part.Massless = true

			local weld = Instance.new("WeldConstraint")
			weld.Part0 = core_part
			weld.Part1 = part
			weld.Parent = part
		end
	end

	return true
end

function UnitModelService.ApplyModel(core_part, model_key)
	if not core_part or not core_part:IsA("BasePart") then
		return
	end

	local template = ModelLibraryService.GetTemplate(model_key)
	if not template then
		core_part.Transparency = 0
		return
	end

	clear_visuals(core_part)

	local visual = template:Clone()
	visual.Name = "Visual"
	visual.Parent = core_part

	local ok = weld_model_to_core(visual, core_part)
	if ok then
		core_part.Transparency = 1
	else
		visual:Destroy()
		core_part.Transparency = 0
	end
end

return UnitModelService
]]></string>
